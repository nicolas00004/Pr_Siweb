# Conexión a MongoDB (router mongos del cluster sharded)
# En local con Docker:        mongodb://localhost:27017/infuni
# En el VPS (mismo host):      mongodb://localhost:27017/infuni
MONGODB_URI=mongodb://localhost:27017/infuni

# Puerto en el que escucha Express
PORT=3000

# Entorno: "production" desactiva el auto-open del navegador y otras ayudas de dev
NODE_ENV=development
